import { test } from "node:test";
import assert from "node:assert/strict";
import { orderTotals } from "../server/services/orderService.js";

test("totals add the delivery fee to the subtotal", () => {
  const totals = orderTotals([{ price: 1250000, quantity: 2 }]);
  assert.deepEqual(totals, { subtotal: 2500000, delivery: 150000, total: 2650000 });
});
