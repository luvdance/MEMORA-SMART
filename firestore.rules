rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // ── ADMIN — full access ──
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ── USERS ──
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId);
    }

    // ── CVs ──
    match /cvs/{cvId} {
      allow read: if isLoggedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isLoggedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isLoggedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── PAYMENTS ──
    match /payments/{paymentId} {
      allow read: if isLoggedIn() && resource.data.userId == request.auth.uid;
    }

    // ── PENDING TRANSFERS ──
    match /pending_transfers/{transferId} {
      allow read: if isLoggedIn() && resource.data.userId == request.auth.uid;
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ── SETTINGS ──
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── CONVERSATIONS ──
    match /conversations/{conversationId} {
      allow read: if isLoggedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isLoggedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() >= 2;
      allow update: if isLoggedIn() &&
        request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isLoggedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isLoggedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isLoggedIn() &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // ── PRESENCE ──
    match /presence/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId);
    }

    // ── PUBLIC KEYS ──
    match /publicKeys/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId);
    }

    // ── MEMORA IDs — unique student ID counter ──
    match /memoraIds/{memoraId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
    }

    match /memoraCounters/{counterId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }

    // ── STUDENTS — main academy collection ──
    match /students/{userId} {
      // Student can read and write their own top-level record
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Enrollments subcollection
      match /enrollments/{courseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
      }

      // Lesson progress subcollection
      match /progress/{progressId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Any other subcollections inside students
      match /{subcollection}/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // ── ACADEMY COURSES — admin writes, students read ──
    match /courses/{courseId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();

      match /{subcollection}/{docId} {
        allow read: if isLoggedIn();
        allow write: if isAdmin();
      }
    }

    // ── LEADERBOARD — any student can read, own entry only to write ──
    match /leaderboard/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId);
    }

    // ── BLOCKS ──
    match /blocks/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
  }
}