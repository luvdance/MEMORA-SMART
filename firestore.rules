rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && 
             request.auth.token != null && 
             request.auth.token.admin == true;
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // ── ADMIN — full access to everything ──
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ── USERS ──
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId);
    }

    // ── CVs ──
    match /cvs/{cvId} {
      allow read: if isLoggedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow create: if isLoggedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isLoggedIn() &&
        resource.data.ownerId == request.auth.uid;
    }

    // ── PAYMENTS — webhook writes only, users read own ──
    match /payments/{paymentId} {
      allow read: if isLoggedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // ── PENDING TRANSFERS ──
    match /pending_transfers/{transferId} {
      allow read: if isLoggedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    // ── SETTINGS — public read, admin write ──
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── CONVERSATIONS ──
    function inConversationId(cid) {
      return isLoggedIn() && request.auth.uid in cid.split('__');
    }

    function otherInConversation(cid) {
      return cid.split('__')[0] == request.auth.uid
        ? cid.split('__')[1]
        : cid.split('__')[0];
    }

    function blockedBy(otherUid) {
      return exists(/databases/$(database)/documents/students/$(otherUid)/blocks/$(request.auth.uid));
    }

    match /conversations/{conversationId} {
      allow read: if inConversationId(conversationId)
                  || (isLoggedIn() && resource != null
                      && request.auth.uid in resource.data.participants);

      allow create: if inConversationId(conversationId)
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      allow update: if inConversationId(conversationId)
                    && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if inConversationId(conversationId);

        allow create: if inConversationId(conversationId)
                      && request.resource.data.senderUid == request.auth.uid
                      && !blockedBy(otherInConversation(conversationId))
                      && request.resource.data.keys().hasOnly([
                           'conversationId', 'senderUid', 'payload', 'sentAt'
                         ]);

        allow update, delete: if false;
      }
    }

    // ── USERNAME CLAIMS ──
    match /usernames/{usernameKey} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── PRESENCE ──
    match /presence/{userId} {
      allow get: if isLoggedIn();
      allow list: if isLoggedIn();
      allow create, update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.keys().hasOnly([
                         'uid', 'online', 'status', 'name', 'level', 'badges',
                         'lessonTitle', 'lastSeen'
                       ])
                    && (!('status' in request.resource.data)
                        || request.resource.data.status in ['online', 'idle', 'offline']);
      allow delete: if isOwner(userId);
    }

    // ── PUBLIC KEYS ──
    match /publicKeys/{userId} {
      allow read: if isLoggedIn();
      allow create, update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.keys().hasOnly([
                         'uid', 'publicKey', 'algorithm', 'updatedAt'
                       ]);
      allow delete: if false;
    }

    // ── MEMORA IDs & COUNTERS ──
    match /memoraIds/{memoraId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
    }

    // Fixed: matches doc(db, "counters", "memoraId") in ensureStudent()
    match /counters/{counterId} {
      allow read, write: if isLoggedIn();
    }

    match /memoraCounters/{counterId} {
      allow read, write: if isLoggedIn();
    }

    // ── STUDENTS — main academy collection ──
    match /students/{userId} {
      allow get: if isOwner(userId);
      allow list: if isLoggedIn() && request.auth.uid == userId;
      allow create, update: if isOwner(userId);

      // Enrollments subcollection
      match /enrollments/{courseId} {
        allow read, write: if isOwner(userId);
      }

      // Lesson progress subcollection
      match /progress/{progressId} {
        allow read, write: if isOwner(userId);
      }

      // Blocks
      match /blocks/{blockedUid} {
        allow read, write: if isOwner(userId);
      }

      // Final exam attempts (server-only write)
      match /examAttempts/{attemptId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ── ACADEMY COURSES — admin writes, students read ──
    match /courses/{courseId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();

      match /{subcollection}/{docId} {
        allow read: if isLoggedIn();
        allow write: if isAdmin();
      }
    }

    // ── LEADERBOARD ──
    match /leaderboard/{userId} {
      allow read: if isLoggedIn();
      allow create, update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.keys().hasOnly([
                         'uid', 'name', 'xp', 'level', 'levelName',
                         'streak', 'updatedAt'
                       ])
                    && request.resource.data.xp is int;
      allow delete: if isOwner(userId);
    }

    // ── BLOCKS (legacy top-level) ──
    match /blocks/{userId}/{document=**} {
      allow read, write: if false;
    }

    // ── REPORTS ──
    match /reports/{reportId} {
      allow create: if isLoggedIn()
                    && request.resource.data.byUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── CERTIFICATES ──
    match /certificates/{certId} {
      allow read: if isLoggedIn() &&
        resource.data.uid == request.auth.uid;
    }

    // ── FINAL EXAM ATTEMPTS ──
    match /examAttempts/{attemptId} {
      allow read, write: if false;
    }
  }
}