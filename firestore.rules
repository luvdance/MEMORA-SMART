rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    // ── ADMIN — full access to everything ──
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ── USERS ──
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId);
    }

    // ── CVs ──
    match /cvs/{cvId} {
      allow read: if isLoggedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow create: if isLoggedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isLoggedIn() &&
        resource.data.ownerId == request.auth.uid;
    }

    // ── PAYMENTS — webhook writes only, users read own ──
    match /payments/{paymentId} {
      allow read: if isLoggedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // ── PENDING TRANSFERS ──
    match /pending_transfers/{transferId} {
      allow read: if isLoggedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    // ── SETTINGS — public read, admin write ──
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── CONVERSATIONS ──
    //
    // Membership comes from the conversation ID, not from a get() on the
    // parent document. conversationIdFor() in e2ee.js is the two uids sorted
    // and joined with "__", and both clients compute it identically.
    //
    // WHY NOT get(): the parent does not exist until the first message is
    // sent, and get() on a missing document returns null -- so reading
    // .data.participants errored, and the rule DENIED. Every first message
    // failed; every later one failed too, because sendMessage was writing
    // { lastMessage, lastMessageAt, lastSenderId } with no participants field
    // at all. The admin account appeared to work only because the isAdmin()
    // rule at the top bypasses all of this, which made a total failure look
    // like a one-way one.
    //
    // Deriving from the ID also removes a billed get() per message read, and
    // grants nothing extra: a learner is only ever a member of IDs that
    // contain their own uid, and sending still requires senderUid == uid.
    function inConversationId(cid) {
      return isLoggedIn() && request.auth.uid in cid.split('__');
    }

    match /conversations/{conversationId} {
      // `resource` is null for a document that does not exist, so the ID
      // check must come first -- it is also the one that works on create.
      allow read: if inConversationId(conversationId)
                  || (isLoggedIn() && resource != null
                      && request.auth.uid in resource.data.participants);

      allow create: if inConversationId(conversationId)
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;

      // A member may bump updatedAt, but may not rewrite who is in the
      // conversation.
      allow update: if inConversationId(conversationId)
                    && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        // Works on an empty thread, which the get() form did not.
        allow read: if inConversationId(conversationId);

        allow create: if inConversationId(conversationId)
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                           'conversationId', 'senderUid', 'payload', 'sentAt'
                         ]);

        // Immutable once sent. Editing history in place would make a thread
        // untrustworthy, and neither side can verify a change.
        allow update, delete: if false;
      }
    }

    // ── USERNAME CLAIMS ──
    //
    // Readable so the form can say a name is taken. Create-only per key:
    // Firestore is atomic on document creation, so two learners cannot claim
    // the same name. Never updatable or deletable, so a claim cannot be
    // reassigned to somebody else.
    match /usernames/{usernameKey} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── PRESENCE ──
    //
    // A minimal public projection. `name` is a USERNAME, never the real name
    // from the account provider. hasOnly is what keeps it minimal as the code
    // changes around it: without it, any field a future client decides to
    // write -- an email, a phone number, a real name -- becomes readable by
    // every signed-in learner.
    match /presence/{userId} {
      allow get: if isLoggedIn();
      allow list: if isLoggedIn();
      allow create, update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.keys().hasOnly([
                         'uid', 'online', 'name', 'level', 'badges',
                         'lessonTitle', 'lastSeen'
                       ]);
      allow delete: if isOwner(userId);
    }

    // ── PUBLIC KEYS ──
    //
    // Readable by design: a public key is useless without its private half,
    // and others need it in order to encrypt. Not deletable -- removing
    // someone's key would silently stop anyone being able to message them.
    match /publicKeys/{userId} {
      allow read: if isLoggedIn();
      allow create, update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.keys().hasOnly([
                         'uid', 'publicKey', 'algorithm', 'updatedAt'
                       ]);
      allow delete: if false;
    }

    // ── MEMORA IDs — atomic unique ID generation ──
    match /memoraIds/{memoraId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
    }

    match /memoraCounters/{counterId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
    }

    // ── STUDENTS — main academy collection ──
    match /students/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Enrollments subcollection
      match /enrollments/{courseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
      }

      // Lesson progress subcollection
      match /progress/{progressId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Who this learner has blocked. Private to them: a blocked person
      // must not be able to discover that they were blocked.
      match /blocks/{blockedUid} {
        allow read, write: if isOwner(userId);
      }

      // EXAM ATTEMPTS ARE SERVER-ONLY. This is the path the code actually
      // uses -- academyService reads students/{uid}/examAttempts -- and the
      // "catch-all for any other subcollections" that used to sit here made
      // it CLIENT-WRITABLE. A learner could write their own passing attempt,
      // which would make every certificate meaningless.
      //
      // A catch-all also could not have been narrowed by adding a stricter
      // rule underneath it: Firestore grants access if ANY rule allows it, so
      // the permissive one would still win. It had to go rather than be
      // overridden.
      match /examAttempts/{attemptId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ── ACADEMY COURSES — admin writes, students read ──
    match /courses/{courseId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();

      match /{subcollection}/{docId} {
        allow read: if isLoggedIn();
        allow write: if isAdmin();
      }
    }

    // ── LEADERBOARD — any student reads, own entry writes ──
    //
    // The only Academy collection every signed-in learner may read in full,
    // and deliberately a minimal projection: `name` is the USERNAME, with no
    // email, no phone and no score history. hasOnly is the part that keeps it
    // that way -- an unconstrained write rule means whatever the client sends
    // becomes visible to everyone.
    match /leaderboard/{userId} {
      allow read: if isLoggedIn();
      allow create, update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.keys().hasOnly([
                         'uid', 'name', 'xp', 'level', 'levelName',
                         'streak', 'updatedAt'
                       ])
                    && request.resource.data.xp is int;
      // Leaving the board is how a learner opts out of it.
      allow delete: if isOwner(userId);
    }

    // ── BLOCKS ──
    //
    // Blocks live at students/{uid}/blocks, which is private to the learner
    // by construction. This top-level collection is from an earlier shape and
    // is closed rather than left readable.
    match /blocks/{userId}/{document=**} {
      allow read, write: if false;
    }

    // ── REPORTS — any logged-in user creates, admin reads ──
    //
    // byUid must be the person filing it. Without that check a learner could
    // file reports in somebody else's name. Not client-readable at all -- not
    // even your own -- so the collection cannot be used to work out who has
    // been reported.
    match /reports/{reportId} {
      allow create: if isLoggedIn()
                    && request.resource.data.byUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── CERTIFICATES — server-written, student reads own ──
    match /certificates/{certId} {
      allow read: if isLoggedIn() &&
        resource.data.uid == request.auth.uid;
    }

    // ── FINAL EXAM ATTEMPTS — server-written only ──
    //
    // Nothing reads or writes this top-level collection: attempts live at
    // students/{uid}/examAttempts, which is where the rule that matters is.
    // Kept closed rather than deleted, so a stray write here cannot create a
    // second, unprotected home for exam results.
    match /examAttempts/{attemptId} {
      allow read, write: if false;
    }
  }
}