rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // EXISTING RULES — unchanged
    // ═══════════════════════════════════════════════════════════════

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /cvs/{cvId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /pending_transfers/{transferId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // MEMORA SMART ACADEMY
    //
    // TRUST LEVEL: MIXED, and deliberately so.
    //
    //   PRACTICE progress (enrollments, per-lesson scores, XP) is written by
    //   the signed-in client. These rules constrain the SHAPE of those writes
    //   rather than their honesty.
    //
    //   EXAM attempts and CERTIFICATES are written only by the server, via
    //   the Admin SDK, after it has graded the paper itself and verified the
    //   candidate from their Firebase ID token. Client writes are denied
    //   outright. See lib/academy/finalExam/record.js.
    //
    // The split is the point: a practice score is a study aid and nobody is
    // harmed if a learner fudges one, whereas a certificate is a claim made
    // to an employer and must not be self-issued.
    //
    // What these rules DO guarantee:
    //   · nobody can read another student's record
    //   · a Memora ID, once issued, can never be changed or reassigned
    //   · a Memora ID can never be claimed twice (create-only on the key)
    //   · the ID counter can only ever move forward by one
    //
    //   · an exam attempt or certificate can only have come from the server
    //
    // What they CANNOT guarantee:
    //   · that a practice score or XP total is honest. A determined user
    //     could write themselves a lesson pass. That does not reach the
    //     certificate, which is graded and written server-side.
    //
    // To raise practice progress to the same level, move recordAssessment()
    // and awardXp() into /api/academy/* behind the same ID-token check that
    // finalExam.js uses, then deny client writes to enrollments and progress
    // below.
    // ═══════════════════════════════════════════════════════════════

    match /students/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.xp == 0;

      // The Memora ID is permanent: an update may never CHANGE it. The
      // get(..., default) form also lets a record that somehow exists without
      // an ID receive its first one, instead of being permanently stuck.
      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.memoraId ==
                       resource.data.get('memoraId', request.resource.data.memoraId);

      allow delete: if false;

      // Enrollments and per-lesson progress are client-written, at the
      // preview trust level described above.
      //
      // These are listed EXPLICITLY and the previous `match /{document=**}`
      // catch-all is gone on purpose. Firestore grants access if ANY rule
      // allows it, so a permissive catch-all here could not be narrowed by
      // adding a stricter rule for a subcollection underneath it — the
      // catch-all would still win. Exam attempts must be server-only, so the
      // catch-all had to go rather than be overridden.
      match /enrollments/{courseId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /progress/{progressId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Exam attempts: readable by the student, written only by the server
      // through the Admin SDK, which bypasses these rules entirely. A client
      // cannot write itself a pass, which is what makes the certificate mean
      // something.
      match /examAttempts/{attemptId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Memora ID → uid claim. Create-only: Firestore guarantees atomicity on
    // the document key, so two people cannot claim the same ID. Never
    // updatable or deletable, so an ID cannot be reassigned.
    match /memoraIds/{memoraId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Certificates are issued by the server only, after it has graded the
    // exam and verified the candidate's ID token. Writes are denied here for
    // everyone; the Admin SDK bypasses these rules, so that route still works
    // and is the only route.
    //
    // A holder may read their own certificate so it can be displayed. `list`
    // is denied so nobody can enumerate the collection and harvest the names
    // and email addresses of every graduate.
    match /certificates/{certificateId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow write: if false;
    }

    // The certificate number counter. Server-only, like the certificates it
    // numbers — uniqueness rests on the atomic create of certificates/{id}
    // inside a transaction, and the counter is only an optimisation.
    match /counters/certificateId {
      allow read, write: if false;
    }

    // The ID sequence. It may only advance by exactly one, so a client cannot
    // jump the counter — except at a year boundary, where the sequence
    // restarts at 1 under a new year. Without that second clause every signup
    // on 1 January would be rejected.
    match /counters/memoraId {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.seq == 1;
      allow update: if isSignedIn()
                    && (
                      request.resource.data.seq == resource.data.seq + 1
                      || (
                        request.resource.data.year != resource.data.year
                        && request.resource.data.seq == 1
                      )
                    );
      allow delete: if false;
    }
  }
}
