{
  "functions": {
    "api/generate-pdf.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/memotify.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/memotify?action=cron",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/lab/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|gif|ico|woff|woff2|ttf|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/academy/:action",
      "destination": "/api/academy?action=:action"
    },
    {
      "source": "/api/memotify/:action",
      "destination": "/api/memotify?action=:action"
    },
    {
      "source": "/api/cv/:action",
      "destination": "/api/cv?action=:action"
    },
    {
      "source": "/api/ats-score",
      "destination": "/api/cv?action=ats-score"
    },
    {
      "source": "/api/optimize-cv",
      "destination": "/api/cv?action=optimize"
    },
    {
      "source": "/api/verify-paystack-payment",
      "destination": "/api/cv?action=verify-payment"
    },
    {
      "source": "/api/requery-payment",
      "destination": "/api/cv?action=requery"
    },
    {
      "source": "/api/project-formatter/classify",
      "destination": "/api/project-formatter/ai?action=classify"
    },
    {
      "source": "/api/project-formatter/generate-content",
      "destination": "/api/project-formatter/ai?action=generate-content"
    },
    {
      "source": "/cv-builder",
      "destination": "/cv-builder/index.html"
    },
    {
      "source": "/ats-check",
      "destination": "/ats-check/index.html"
    },
    {
      "source": "/projectpilot",
      "destination": "/projectpilot/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/memotify",
      "destination": "/memotify/index.html"
    },
    {
      "source": "/memotify/jobs",
      "destination": "/memotify/jobs/index.html"
    },
    {
      "source": "/memotify/hire",
      "destination": "/memotify/hire/index.html"
    },
    {
      "source": "/academy",
      "destination": "/academy/index.html"
    },
    {
      "source": "/academy/courses",
      "destination": "/academy/courses/index.html"
    },
    {
      "source": "/academy/enroll",
      "destination": "/academy/enroll/index.html"
    },
    {
      "source": "/library",
      "destination": "/library/index.html"
    },
    {
      "source": "/excel-masterclass",
      "destination": "/excel-masterclass/index.html"
    },
    {
      "source": "/ai-side-hustles",
      "destination": "/ai-side-hustles/index.html"
    },
    {
      "source": "/remote-jobs-guide",
      "destination": "/remote-jobs-guide/index.html"
    },
    {
      "source": "/content-creation",
      "destination": "/content-creation/index.html"
    },
    {
      "source": "/digital-skills",
      "destination": "/digital-skills/index.html"
    },
    {
      "source": "/daniel-nwankwo",
      "destination": "/daniel-nwankwo/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}